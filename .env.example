# Copy to .env (never commit .env). There are NO secrets in this file by design.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000

# ---- Switches ---------------------------------------------------------------
# DATA_BACKEND: sqlserver   = everything in a local SQL Server DB (auto-created on startup)
#               local_files = everything in ./data as .jpg/.json files (zero setup)
#               azure_blob  = Azure Blob Storage (production)
DATA_BACKEND=sqlserver
# AI_BACKEND:   mock    = offline fake AI, no Azure, no cost (does NOT really look at the photo)
#               foundry = Claude on Microsoft Foundry (real analysis, billed)
AI_BACKEND=mock
# Sign in as a local admin without Entra ID (development only)
DEV_AUTH_BYPASS=true

# ---- Local SQL Server (Windows authentication, no password) ----------------
SQLSERVER_SERVER=localhost\SQLEXPRESS
SQLSERVER_DATABASE=TyreAdvisor
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# ---- Claude on Microsoft Foundry (only when AI_BACKEND=foundry) -------------
FOUNDRY_RESOURCE=
CLAUDE_DEPLOYMENT=claude-opus-5

# ---- Entra ID (only when DEV_AUTH_BYPASS=false) -----------------------------
ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
ENTRA_CLIENT_ID=
MANAGED_IDENTITY_CLIENT_ID=
ADMIN_APP_ROLE=Tyre.Admin

# ---- Azure Blob Storage (only when DATA_BACKEND=azure_blob) -----------------
STORAGE_ACCOUNT_URL=
REFERENCE_CONTAINER=tyre-references
UPLOAD_CONTAINER=tyre-uploads
LOCAL_DATA_DIR=./data

# ---- Tyre rules (adjust to your country's legal minimum) --------------------
LEGAL_MIN_TREAD_MM=1.6
RECOMMENDED_MIN_TREAD_MM=3.0
DEFAULT_NEW_TREAD_MM=8.0
DEFAULT_KM_PER_MM=8000
